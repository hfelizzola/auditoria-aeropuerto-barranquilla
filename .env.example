# ==============================================================================
# .env.example - Plantilla de Variables de Entorno
# Copia este archivo como '.env' y completa con tus valores reales:
# cp .env.example .env
# ==============================================================================

# Proveedor por defecto de las fases 3 y 4 (se puede cambiar con --modelo-vision)
MODELO_VISION=gemini

# API de Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# API de Anthropic / Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Profundidad de razonamiento: low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# 1 = si el modelo rechaza una solicitud, el servidor reintenta con un modelo de respaldo
CLAUDE_FALLBACKS=1

# ==============================================================================
# Credenciales de Descarga para SharePoint Online (aerobaq.sharepoint.com)
# ==============================================================================
# Opción 1: Usuario y contraseña (para cuentas sin doble factor obligatorio)
SHAREPOINT_USER=tu_usuario@aerobaq.com
SHAREPOINT_PASSWORD=tu_contraseña_aqui

# Opción 2: Cookie de sesión FedAuth (si la cuenta exige MFA / Microsoft Authenticator)
# Copiar desde el navegador (F12 -> Aplicación -> Cookies -> aerobaq.sharepoint.com -> FedAuth):
SHAREPOINT_FEDAUTH=
SHAREPOINT_RTFA=

# ==============================================================================
# Microsoft Graph (respaldo para enlaces de compartición ':b:'), scope Files.Read.All
# ==============================================================================
# Opción A: token de acceso temporal (p. ej. copiado de Graph Explorer)
GRAPH_ACCESS_TOKEN=
# Opción B: registro de aplicación de Entra ID (flujo de código de dispositivo; requiere 'pip install msal')
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
