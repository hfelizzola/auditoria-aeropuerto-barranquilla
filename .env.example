# ==============================================================================
# .env.example - Plantilla de Variables de Entorno
# Copia este archivo como '.env' y completa con tus valores reales:
# cp .env.example .env
# ==============================================================================

# API de Google Gemini (Obtén tu clave en https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Modelo de Gemini para visión y análisis multimodal (por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Credenciales de Descarga para SharePoint Online (aerobaq.sharepoint.com)
# ==============================================================================
# Opción 1: Usuario y contraseña (para cuentas sin doble factor obligatorio)
SHAREPOINT_USER=tu_usuario@aerobaq.com
SHAREPOINT_PASSWORD=tu_contraseña_aqui

# Opción 2: Cookie de sesión FedAuth (si la cuenta exige MFA / Microsoft Authenticator)
# Copiar desde el navegador (F12 -> Aplicación -> Cookies -> aerobaq.sharepoint.com -> FedAuth):
SHAREPOINT_FEDAUTH=
SHAREPOINT_RTFA=

